# FrameTrain Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# DATABASE
# ============================================
# For local development: Use your Supabase PostgreSQL connection string
# Get it from: https://supabase.com → Project Settings → Database → Connection String
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres"

# ============================================
# JWT SECRET (Authentication)
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Salt für API-Key-Hashes (src/lib/api-key.ts) – ohne diese Variable startet
# das API-Key-Hashing nicht. Generieren z.B. mit: openssl rand -hex 32
API_KEY_SALT="dein-api-key-salt"

# ============================================
# STRIPE (Payment)
# ============================================
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price-IDs für die beiden Abo-Pläne (Stripe Dashboard → Products)
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_YEARLY="price_..."

# ============================================
# API CONFIGURATION
# ============================================
API_URL="http://localhost:5001"
NEXT_PUBLIC_API_URL="http://localhost:5001"
# Basis-URL der Website selbst (für OAuth-Redirects, SSO-Callbacks etc.)
NEXT_PUBLIC_URL="http://localhost:5001"
# Kanonische Site-URL für SEO (Canonicals, hreflang, og:url, Sitemap, robots.txt).
# Fällt ohne diese Variable auf https://frame-train.com zurück.
NEXT_PUBLIC_SITE_URL="https://frame-train.com"

# ============================================
# APP DOWNLOAD
# ============================================
APP_DOWNLOAD_BASE_URL="https://github.com/FrameSphere/FrameTrain-App/releases/latest/download"

# ============================================
# GITHUB (OAuth-Login + Desktop App Downloads)
# ============================================
# OAuth-App: https://github.com/settings/developers
GITHUB_CLIENT_ID="dein-github-oauth-client-id"
GITHUB_CLIENT_SECRET="dein-github-oauth-client-secret"
# Your GitHub username/organization (für Release-Downloads)
GITHUB_OWNER="FrameSphere"
# Your repository name
GITHUB_REPO="FrameTrain-App"
# Optional: Personal Access Token (only for private repos)
# Leave empty for public repositories
GITHUB_TOKEN=""

# ============================================
# GOOGLE OAUTH (Login)
# ============================================
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="dein-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="dein-google-oauth-client-secret"

# ============================================
# FRAMESPHERE SSO
# ============================================
FRAMESPHERE_URL="https://frame-sphere.vercel.app"
FRAMESPHERE_API_URL="https://framesphere-backend.vercel.app/api"
FRAMESPHERE_CLIENT_ID="frametrain"
FRAMESPHERE_CLIENT_SECRET="dein-framesphere-client-secret"

# ============================================
# RESEND (E-Mail-Verifikation)
# ============================================
# API-Key aus dem Resend-Dashboard: https://resend.com/api-keys
# Voraussetzung: frame-train.com muss dort als Domain verifiziert sein (DNS-Records gesetzt).
RESEND_API_KEY="re_..."
# Absenderadresse – muss auf der bei Resend verifizierten Domain liegen.
EMAIL_FROM="FrameTrain <no-reply@frame-train.com>"

# ============================================
# OPEN LIBRARY ADMIN (Script Verification)
# ============================================
# Beliebiges starkes Passwort – muss in Manager/components.js als FT_ADMIN_TOKEN eingetragen werden
# Generieren z.B. mit: openssl rand -hex 32
LIBRARY_ADMIN_SECRET="dein-geheimes-admin-token"

# Anthropic (Claude) API Key für die automatische, strenge Script-Prüfung
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: Modell überschreiben (Standard: claude-sonnet-5).
# Stärker (teurer): claude-opus-5. Hinweis: claude-haiku-4-5 NICHT nutzen –
# unterstützt output_config.effort nicht und würde 400 werfen.
# AI_AUDIT_MODEL="claude-opus-5"
# Optional: Schwellwerte der Auto-Entscheidung (streng). Standard: 85 / 40
# AI_APPROVE_THRESHOLD="85"   # Score >= X → automatisch freigeben
# AI_REJECT_THRESHOLD="40"    # Score <  X → automatisch ablehnen

# ============================================
# SONSTIGE INTEGRATIONEN
# ============================================
# Schützt POST /api/status-updates – nur Codex/CI darf damit Status posten
CODEX_API_KEY="dein-codex-api-key"
# Schützt die Vercel-Cron-Route /api/cron/expire-promo-access
CRON_SECRET="dein-cron-secret"
# WebControl HQ Manager API (Changelog, Support-Tickets im Dashboard)
NEXT_PUBLIC_MANAGER_API_URL="https://webcontrol-hq-api.karol-paschek.workers.dev"

# ============================================
# ANALYTICS & CONVERSION-TRACKING (optional)
# ============================================
# Alle drei IDs sind OPTIONAL. Ist eine Variable leer/nicht gesetzt, wird das
# jeweilige Script NIE geladen. Zusätzlich gilt: geladen wird erst nach
# ausdrücklicher Zustimmung im Cookie-Banner (Google Consent Mode v2 steht
# per Default auf "denied"). Ohne gesetzte IDs erscheint auch kein Banner.
#
# Google Analytics 4 – Mess-ID aus GA4 → Verwaltung → Datenstreams (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel – Pixel-ID aus dem Events Manager (nur Ziffern)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads – Conversion-ID aus Google Ads → Tools → Conversions (Format: AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads – Conversion-Label des Kauf-Conversions (Format: AbC-D_efGhIjK).
# Steht in Google Ads beim Conversion-Tag als send_to: "AW-123456789/AbC-D_efGhIjK".
# Ohne Label kann Google Ads den Kauf NICHT zuordnen (GA4 + Meta feuern trotzdem).
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# ── Serverseitiges Conversion-Tracking (src/lib/server-analytics.ts) ──────────
# Erfasst Käufe, die der Browser-Pixel NICHT sieht: trial → paid (erste echte
# Abbuchung nach Gratismonaten), Verlängerungen und Käufe mit geblocktem Pixel.
# Einhängepunkt: invoice.payment_succeeded in src/app/api/payment/webhook/route.ts.
# Ohne diese beiden Secrets bleibt das serverseitige Tracking komplett inaktiv
# (No-Op, kein Fehler) – der Webhook läuft unverändert weiter.
#
# Meta Conversions API: Events Manager → Datenquelle → Einstellungen →
# "Conversions API" → Zugriffsschlüssel erstellen. Nutzt NEXT_PUBLIC_META_PIXEL_ID.
META_CAPI_ACCESS_TOKEN=
# Optional, nur zum Debuggen: Testereignis-Code aus dem Events Manager
# ("Testereignisse"-Tab). Im Livebetrieb LEER lassen – sonst landen echte
# Käufe nur im Testpuffer und nicht in der Attribution.
META_CAPI_TEST_EVENT_CODE=
# GA4 Measurement Protocol: GA4 → Verwaltung → Datenstreams → Stream wählen →
# "Measurement Protocol API-Secrets" → Erstellen. Die Measurement-ID selbst
# kommt aus NEXT_PUBLIC_GA_ID.
GA4_API_SECRET=

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV="development"
