// Prisma Schema for FrameTrain Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique                  // always required – SSO users always have email
  name              String?
  communityName     String?   @unique @map("community_name") // Eindeutiger Name für Open Library Scripts
  passwordHash      String?   @map("password_hash")
  desktopPasswordHash String? @map("desktop_password_hash") // separates Passwort für Desktop-App (OAuth-User)
  provider          String?                            // "email" | "google" | "github" | "framesphere"
  providerAccountId String?   @map("provider_account_id")
  framesphereUserId String?   @unique @map("framesphere_user_id")
  emailVerified                Boolean   @default(false) @map("email_verified") // OAuth/SSO-User werden bei Erstellung direkt verifiziert (Provider bürgt für die E-Mail)
  emailVerifiedAt              DateTime? @map("email_verified_at")
  emailVerificationTokenHash   String?   @unique @map("email_verification_token_hash") // SHA-256-Hash des Tokens aus der Mail – Klartext wird nie gespeichert
  emailVerificationExpires     DateTime? @map("email_verification_expires")
  hasPaid              Boolean   @default(false) @map("has_paid")
  lifetimeAccess       Boolean   @default(false) @map("lifetime_access") // Zugang via Lifetime-Promo-Code — darf nie durch Abo-Events deaktiviert werden
  promoAccessUntil     DateTime? @map("promo_access_until") // Zugang via Gratismonate-Code OHNE Abo — läuft zu diesem Zeitpunkt automatisch ab (Cron deaktiviert dann Zugang + API-Keys)
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  subscriptionCancelAt DateTime? @map("subscription_cancel_at")
  subscriptionTrialEnd DateTime? @map("subscription_trial_end") // Ende der Stripe-Gratiszeit (Trial); erste Abbuchung erfolgt danach
  termsAcceptedAt      DateTime? @map("terms_accepted_at")            // Zeitpunkt der Zustimmung zu AGB & Datenschutz
  termsVersion         String?   @map("terms_version")                // Fassung, der zugestimmt wurde (CURRENT_TERMS_VERSION in src/lib/legal-version.ts); null = vor Oktober 2026
  diagnosticsConsent   Boolean   @default(false) @map("diagnostics_consent") // Optionale Einwilligung: Desktop-App darf anonyme Fehlerdaten senden
  diagnosticsConsentAt DateTime? @map("diagnostics_consent_at")
  emailLocale          String    @default("de") @map("email_locale")          // Sprache für E-Mails ("de" | "en"), gesetzt bei der Registrierung
  onboardingEmails     Boolean   @default(true) @map("onboarding_emails")    // Einstiegs-Tipps per Mail; Abmeldung per Link in jeder Mail
  onboardingStep       Int       @default(0) @map("onboarding_step")         // Zuletzt versendete Onboarding-Mail (0 = noch keine)
  onboardingLastSentAt DateTime? @map("onboarding_last_sent_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  apiKeys          ApiKey[]
  models           Model[]
  payments         Payment[]
  libraryScripts   LibraryScript[]
  promoRedemptions PromoCodeRedemption[]
  mcpDevices       McpDevice[]
  mcpJobs          McpJob[]
  mcpConnections   McpConnection[]
  supportTickets   SupportTicketLink[]
  oauthAuthCodes   OAuthAuthCode[]
  oauthTokens      OAuthToken[]

  @@map("users")
}

// Promo-Codes (werden von der Admin-Webseite aus angelegt und verwaltet)
model PromoCode {
  id                    String    @id @default(cuid())
  code                  String    @unique                        // immer normalisiert: GROSSBUCHSTABEN, A-Z 0-9, "-" und "_"
  type                  String                                   // "percent" | "free_months" | "lifetime"
  percentOff            Int?      @map("percent_off")            // 1–100, nur bei type=percent
  percentDuration       String?   @map("percent_duration")       // "once" | "forever" | "repeating" (Stripe-Coupon-Duration)
  percentDurationMonths Int?      @map("percent_duration_months") // nur bei percentDuration=repeating
  freeMonths            Int?      @map("free_months")            // nur bei type=free_months
  maxRedemptions        Int?      @map("max_redemptions")        // null = unbegrenzt einlösbar
  redemptionCount       Int       @default(0) @map("redemption_count")
  expiresAt             DateTime? @map("expires_at")             // null = kein Ablaufdatum
  isActive              Boolean   @default(true) @map("is_active")
  stripeCouponId        String?   @map("stripe_coupon_id")       // wird beim ersten Checkout lazy angelegt (nur type=percent)
  note                  String?                                  // interne Admin-Notiz, wird Usern nie angezeigt
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  redemptions PromoCodeRedemption[]

  @@index([isActive])
  @@map("promo_codes")
}

model PromoCodeRedemption {
  id              String    @id @default(cuid())
  promoCodeId     String    @map("promo_code_id")
  userId          String    @map("user_id")
  status          String    @default("pending")      // "pending" (Checkout gestartet) | "completed" (Checkout abgeschlossen / Lifetime eingelöst)
  plan            String?                            // "monthly" | "yearly" | null (lifetime)
  stripeSessionId String?   @map("stripe_session_id")
  redeemedAt      DateTime  @default(now()) @map("redeemed_at")
  completedAt     DateTime? @map("completed_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])                    // jeder User kann jeden Code nur 1× einlösen
  @@index([userId])
  @@map("promo_code_redemptions")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  key        String    @unique
  isActive   Boolean   @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@map("api_keys")
}

model Model {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  description String?
  status      String    @default("created")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    ModelVersion[]

  @@index([userId])
  @@map("models")
}

model ModelVersion {
  id          String    @id @default(cuid())
  modelId     String    @map("model_id")
  version     Int
  parameters  String
  metrics     String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  model       Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, version])
  @@index([modelId])
  @@map("model_versions")
}

model LibraryScript {
  id             String    @id @default(cuid())
  userId         String?   @map("user_id")            // Verknüpfung zum User (Owner des Scripts)
  name           String
  description    String
  author         String                               // Legacy: für Anzeige und historische Daten
  model_type     String    @map("model_type")
  task_type      String    @map("task_type")
  framework      String
  script         String    @db.Text
  script_type    String    @default("train") @map("script_type")
  verified       Boolean   @default(false)
  downloads      Int       @default(0)
  stars          Int       @default(0)
  tags           String[]  @default([])
  aiCheckResult  String?   @db.Text @map("ai_check_result")
  aiCheckedAt    DateTime? @map("ai_checked_at")
  rejectedAt     DateTime? @map("rejected_at")
  rejectedReason String?   @map("rejected_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([verified])
  @@index([model_type])
  @@index([framework])
  @@index([script_type])
  @@index([userId])
  @@map("library_scripts")
}

// Tägliche Status-Updates von Codex (Automatisierung)
model StatusUpdate {
  id          String   @id @default(cuid())
  title       String                           // Kurze Überschrift, z. B. "Synapse Builder: Canvas-Fixes"
  body        String   @db.Text               // Markdown-fähiger Fließtext
  type        String   @default("status")     // "status" | "milestone" | "hotfix" | "dev"
  appVersion  String?  @map("app_version")    // Optional: z. B. "0.9.3-dev"
  source      String?  @map("source")         // Optional: z. B. "desktop-app"
  sourceRef   String?  @map("source_ref")     // Optional: Commit, Tag oder sonstige Referenz
  scope       String?  @map("scope")          // Optional: z. B. "changelog"
  author      String   @default("Codex")      // Wer hat gepostet
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([published])
  @@index([createdAt])
  @@map("status_updates")
}

model Payment {
  id              String    @id @default(cuid())
  userId          String?   @map("user_id")
  email           String
  amount          Int
  currency        String    @default("eur")
  stripePaymentId      String?   @unique @map("stripe_payment_id")
  stripeSessionId      String?   @unique @map("stripe_session_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  stripeInvoiceId      String?   @unique @map("stripe_invoice_id") // Stripe-Rechnung: dedupliziert Verlängerungen & Fehlversuche
  status               String    @default("pending")              // pending | completed | renewed | failed
  billingReason        String?   @map("billing_reason")           // Stripe billing_reason (subscription_create | subscription_cycle | …)
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  user            User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@map("payments")
}

// ─── KI-Verbindungen (MCP) ──────────────────────────────────────────────────
// Die Website ist Remote-MCP-Server (/api/mcp) mit eigenem OAuth 2.1 und reicht
// Werkzeug-Aufrufe per Relay an die Desktop-App des Nutzers weiter. Vertrag:
// docs/mcp/CONTRACT.md. Tokens/Codes werden nur als SHA-256-Hash gespeichert.

// Eine Desktop-App-Installation mit eingeschaltetem Fernzugriff.
model McpDevice {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  deviceId     String   @map("device_id") // UUID aus mcp.json der App
  deviceName   String   @map("device_name")
  appVersion   String   @map("app_version")
  manifestHash String?  @map("manifest_hash")
  manifest     Json? // Tool[] laut Vertrag Abschnitt 1
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs McpJob[]

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
  @@map("mcp_devices")
}

// Ein Werkzeug-Aufruf von einem KI-Client, der auf die Desktop-App wartet.
model McpJob {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  deviceId     String?   @map("device_id") // McpDevice.id; null = jedes Geraet des Nutzers
  connectionId String?   @map("connection_id")
  clientName   String    @map("client_name")
  tool         String
  args         Json
  status       String    @default("queued") // queued | delivered | done | expired
  result       Json? // CallToolResult
  createdAt    DateTime  @default(now()) @map("created_at")
  deliveredAt  DateTime? @map("delivered_at")
  completedAt  DateTime? @map("completed_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     McpDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  connection McpConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([createdAt])
  @@map("mcp_jobs")
}

// OAuth-Client: per DCR registriert oder per Client-ID-Metadata-Document (CIMD).
model OAuthClient {
  id                String    @id @default(cuid())
  clientId          String    @unique @map("client_id") // zufaellig (DCR) oder HTTPS-URL (CIMD)
  clientName        String    @map("client_name")
  redirectUris      String[]  @map("redirect_uris")
  clientUri         String?   @map("client_uri")
  logoUri           String?   @map("logo_uri")
  registrationType  String    @default("dcr") @map("registration_type") // "dcr" | "cimd"
  metadataFetchedAt DateTime? @map("metadata_fetched_at") // nur CIMD
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime? @map("last_used_at")

  @@map("oauth_clients")
}

// Einmal-Code aus dem Authorize-Schritt (10 Minuten gueltig).
model OAuthAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique @map("code_hash")
  clientId      String    @map("client_id")
  userId        String    @map("user_id")
  redirectUri   String    @map("redirect_uri")
  codeChallenge String    @map("code_challenge") // PKCE S256
  scope         String
  resource      String
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_auth_codes")
}

// Access- und Refresh-Token-Paar. Refresh rotiert: jede Nutzung erzeugt eine
// neue Zeile in derselben Familie; Wiederverwendung eines alten Refresh-Tokens
// widerruft die ganze Familie.
model OAuthToken {
  id               String    @id @default(cuid())
  familyId         String    @map("family_id")
  userId           String    @map("user_id")
  clientId         String    @map("client_id")
  connectionId     String    @map("connection_id")
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  scope            String
  resource         String
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime  @map("refresh_expires_at")
  rotatedAt        DateTime? @map("rotated_at") // Refresh-Token wurde eingeloest
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([connectionId])
  @@index([refreshExpiresAt])
  @@map("oauth_tokens")
}

// Sichtbare Verbindung je Nutzer + Client (Dashboard/App: anzeigen, trennen).
model McpConnection {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  clientId   String    @map("client_id")
  clientName String    @map("client_name")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens OAuthToken[]
  jobs   McpJob[]

  @@unique([userId, clientId])
  @@map("mcp_connections")
}

// Support-Tickets (liegen im Manager) einem Konto zuordnen, damit dieselben
// Gespraeche im Chat, im Dashboard und in der App auf jedem Geraet erscheinen.
model SupportTicketLink {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ticketId  Int      @map("ticket_id")
  userToken String   @map("user_token")
  subject   String
  source    String   @default("web") // web | app
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticketId])
  @@index([userId])
  @@map("support_ticket_links")
}
